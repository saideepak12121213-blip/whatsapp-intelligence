# ClassFlow AI — Environment Variables
# Copy this to .env and fill in your values

# JWT Secret (change in production!)
SECRET_KEY=classflow-hackathon-supersecret-jwt-key-2026

# Database (SQLite for MVP, PostgreSQL for production)
DATABASE_URL=sqlite:///./classflow.db

# AI Provider: 'gemini', 'openai', or 'heuristic' (auto = try gemini, fallback to heuristic)
AI_PROVIDER=auto

# Gemini API Key (optional — heuristic NLP engine works without it)
AI_API_KEY=
# GEMINI_API_KEY=

# Environment
ENVIRONMENT=development
